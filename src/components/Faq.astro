---
import { project } from '../projects';
import Section from './Section.astro';
---

<Section id="faq" eyebrow="FAQ" title="Questions buyers ask">
  <div class="divide-y divide-ink/10 border-y border-ink/10">
    {project.faq.map((f) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
          {f.q}
          <span class="text-brand transition group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 max-w-3xl text-ink/70">{f.a}</p>
      </details>
    ))}
  </div>
</Section>

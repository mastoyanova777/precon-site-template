---
import { project } from '../projects';

const { agent, team, disclaimer } = project;
---

<footer class="bg-ink px-4 pb-28 pt-12 text-sm text-white/60 sm:px-6 md:pb-12">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-6 border-b border-white/10 pb-8 md:flex-row md:justify-between">
      <div>
        <p class="font-serif text-xl text-white">{project.name}</p>
        <p class="mt-1">{project.city}</p>
      </div>
      <dl class="grid grid-cols-2 gap-x-10 gap-y-2">
        {team.map((t) => (
          <>
            <dt>{t.role}</dt>
            <dd class="text-white/85">{t.name}</dd>
          </>
        ))}
      </dl>
      <div>
        <p class="text-white/85">{agent.name}</p>
        <p>{agent.brokerage}{agent.license && ` · License #${agent.license}`}</p>
        {agent.phone && <a class="block hover:text-white" href={`tel:${agent.phone.replace(/[^\d+]/g, '')}`}>{agent.phone}</a>}
        {agent.email && <a class="block hover:text-white" href={`mailto:${agent.email}`}>{agent.email}</a>}
      </div>
    </div>
    <div class="mt-8 grid gap-3 text-xs leading-relaxed text-white/45">
      {disclaimer.map((d) => <p>{d}</p>)}
    </div>
  </div>
</footer>

---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'white' | 'cream' | 'ink';
}
const { id, eyebrow, title, intro, tone = 'white' } = Astro.props;
const bg = { white: 'bg-white', cream: 'bg-cream', ink: 'bg-ink text-white' }[tone];
---

<section id={id} class={`${bg} px-4 py-16 sm:px-6 md:py-24`}>
  <div class="mx-auto max-w-6xl">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-widest text-brand">{eyebrow}</p>}
    <h2 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl md:text-5xl">{title}</h2>
    {intro && <p class="mt-4 max-w-2xl text-lg opacity-80">{intro}</p>}
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>

---
import { project } from '../projects';
import CtaButton from './CtaButton.astro';
import Photo from './Photo.astro';

const { hero, name } = project;
---

<header class="relative isolate overflow-hidden bg-ink text-white">
  {hero.image ? (
    <>
      <Photo photo={hero.image} loading="eager" class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/90 via-ink/60 to-ink/10"></div>
    </>
  ) : (
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,color-mix(in_srgb,var(--brand)_35%,transparent),transparent_60%)]"></div>
  )}
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 sm:px-6">
    <span class="font-serif text-lg tracking-wide sm:text-2xl">{name}</span>
    <div class="flex items-center gap-5">
    {project.agent.neoKey && (
      <a href="/new-developments" class="whitespace-nowrap text-sm font-medium text-white/85 hover:text-white">New Developments</a>
    )}
    <a href="#book" data-cta class="hidden rounded-full border border-white/40 px-5 py-2 text-sm font-medium hover:bg-white/10 sm:inline-block">
      {project.booking.ctaLabel}
    </a>
    </div>
  </nav>
  <div class="mx-auto max-w-6xl px-4 pb-24 pt-16 sm:px-6 md:pb-40 md:pt-28">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand">{hero.eyebrow}</p>
    <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-[1.1] sm:text-5xl md:text-6xl">{hero.headline}</h1>
    <p class="mt-6 max-w-2xl text-lg text-white/80">{hero.subheadline}</p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <CtaButton />
      <a href="#residences" class="inline-flex items-center justify-center rounded-full px-7 py-3.5 font-medium text-white/80 hover:text-white">
        See residences ↓
      </a>
    </div>
  </div>
</header>

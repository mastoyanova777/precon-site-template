---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { project } from '../projects';
import type { Photo } from '../projects/types';

interface Props {
  photo: Photo;
  /** Rendered width hint for the browser, e.g. "(min-width: 768px) 50vw, 100vw". */
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const { photo, sizes = '100vw', class: className = '', loading = 'lazy' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const src = files[`../assets/${project.slug}/${photo.file}`]?.default;
if (!src) {
  throw new Error(`Image "${photo.file}" not found in src/assets/${project.slug}/`);
}
---

<Image
  src={src}
  alt={photo.alt}
  widths={[640, 960, 1440, 1920]}
  sizes={sizes}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
/>

---
import { project } from '../projects';
import Section from './Section.astro';
import CtaButton from './CtaButton.astro';

const { deposit } = project;
---

<Section id="deposit" tone="cream" eyebrow="How you pay" title="Deposit schedule" intro={deposit.intro}>
  {deposit.steps.length === 0 ? (
    <div class="flex flex-col items-start gap-6 rounded-2xl bg-white p-8 md:flex-row md:items-center md:justify-between">
      <p class="max-w-xl text-lg">Deposit terms depend on the unit and whether you buy as a US or international buyer. I will walk you through them on a quick call.</p>
      <CtaButton />
    </div>
  ) : (
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {deposit.steps.map((s, i) => (
      <li class="rounded-2xl bg-white p-6">
        <p class="text-sm text-ink/50">Step {i + 1}</p>
        <p class="mt-1 font-serif text-4xl text-brand">{s.percent}</p>
        <p class="mt-2">{s.when}</p>
      </li>
    ))}
  </ol>
  )}
</Section>

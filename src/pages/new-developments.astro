---
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { project } from '../projects';

const { agent } = project;
---

<Base>
  <header class="bg-ink text-white">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 sm:px-6">
      <a href="/" class="font-serif text-xl tracking-wide sm:text-2xl">{project.name}</a>
      <a href="#book" data-cta class="hidden rounded-full border border-white/40 px-5 py-2 text-sm font-medium hover:bg-white/10 sm:inline-block">
        {project.booking.ctaLabel}
      </a>
    </nav>
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-8 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand">New Developments</p>
      <h1 class="mt-3 max-w-3xl font-serif text-4xl leading-tight sm:text-5xl">South Florida pre-construction, all in one place</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/80">
        Browse new condo and home communities with current pricing and availability. See one you like? Book a call and I'll get you the floor plans, deposit schedule and best available units.
      </p>
      <CtaButton class="mt-8" />
    </div>
  </header>

  <main>
    {agent.neoKey && (
      <section class="bg-white px-2 py-6 sm:px-4">
        <iframe id="NEOiframe" title="New development communities" class="w-full border-0" style="height:200vh"></iframe>
        <script
          is:inline
          async
          src="https://assets.newestateonly.com/iframe-loader/load.js"
          data-neokey={agent.neoKey}
          data-neolang="en"></script>
      </section>
    )}
    <Booking />
  </main>
  <Footer />
  <StickyCta />
</Base>
